NODE_ENV=development
PORT=5000
TZ=Asia/Jakarta

# Application Base URLs (Never hardcode URLs in code)
APP_BASE_URL=http://localhost:5000
API_PREFIX=/api/v1
CLIENT_URL=http://localhost:3000

# MySQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=javapack_db
DB_NAME_TEST=javapack_db_test
DB_USER=root
DB_PASSWORD=
DB_DIALECT=mysql

# JWT Configuration
JWT_SECRET=javapack_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=1d

# Payment Gateway Configuration
PAYMENT_GATEWAY_BASE_URL=https://app.sandbox.midtrans.com
PAYMENT_GATEWAY_SERVER_KEY=your_payment_gateway_server_key

# n8n Automation Webhook
N8N_WEBHOOK_URL=http://localhost:5678/webhook/javapack-order
